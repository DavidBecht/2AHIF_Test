<Window x:Class="_2AHIF_Test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2AHIF_Test"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <DockPanel>
            <Canvas DockPanel.Dock="Top" Background="Gray" Height="50" HorizontalAlignment="Stretch">
                <Button Content="Button" Click="Button_Click"/>
            </Canvas>
            <Canvas DockPanel.Dock="Top" Background="LightBlue" HorizontalAlignment="Stretch"></Canvas>
        </DockPanel>
    </Grid>
</Window>
